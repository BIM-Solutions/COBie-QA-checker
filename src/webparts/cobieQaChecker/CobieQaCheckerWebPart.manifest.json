{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "467a0b8d-14b6-4834-a537-143745bc6dc0",
  "alias": "CobieQaCheckerWebPart",
  "componentType": "WebPart",

  // The "*" signifies that the version should be taken from the package.json
  "version": "*",
  "manifestVersion": 2,

  // The checker only reads files the signed-in user can already see and writes
  // through the SPFx client, so it needs no custom script permission.
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],
  "supportsThemeVariants": true,

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70",
    "group": { "default": "Advanced" },
    "title": { "default": "COBie QA Checker" },
    "description": { "default": "Check a COBie deliverable held in SharePoint against the COBie 2.4 schema." },
    "officeFabricIconFontName": "CheckList",
    "properties": {
      "sourceLibraryUrl": "",
      "reportLibraryUrl": "",
      "recordHistory": true
    }
  }]
}
